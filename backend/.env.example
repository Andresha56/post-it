# Cognito (access token verification)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# MongoDB
MONGO_URI=

# AWS S3 (media uploads)
AWS_REGION=
AWS_S3_BUCKET=

# Zernio (social publishing)
ZERNIO_API_URL=https://api.zernio.com
ZERNIO_API_KEY=
ZERNIO_CALLBACK_URL=
# Shared secret for the POST /webhooks/zernio endpoint. Register a Zernio
# webhook pointing at https://<your-api-host>/webhooks/zernio with this secret
# and the events: account.disconnected, post.published, post.failed,
# post.partial, post.cancelled.
ZERNIO_WEBHOOK_SECRET=

PORT=5000
NODE_ENV=development
