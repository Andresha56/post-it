# AWS Cognito (required for /signin, /signup and /verify-email to work)
# Copy this file to .env and fill in the values from your AWS Cognito user pool.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# GraphQL API the app calls with the Cognito access token
VITE_API_URL=http://localhost:4000/graphql
